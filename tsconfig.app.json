{
  "extends": "./node_modules/@vue/tsconfig/tsconfig.dom",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "three-matcap-orm-material/src/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "lib/*": [
        "./three-matcap-orm-material/src/*"
      ]
    },
    "esModuleInterop": true,
  }
}